{
    "name": "commit-message-writer",
    "displayName": "Commit Message Writer",
    "description": "Generate Git commit messages using AI",
    "version": "1.0.0",
    "publisher": "schakamaier",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "commit-message-writer.generate",
                "title": "Generate Commit Message"
            },
            {
                "command": "commit-message-writer.setApiKey",
                "title": "Set API Key"
            }
        ],
        "configuration": {
            "title": "Commit Message Writer",
            "properties": {
                "commit-message-writer.model": {
                    "type": "string",
                    "default": "google/gemma-4-26b-a4b-it:free",
                    "description": "The AI Model Used to generate commit-messages"
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/vscode": "^1.90.0",
        "typescript": "^5.0.0"
    }
}
